{
  "manifest_version": 3,
  "name": "aegis",
  "version": "1.0.0",
  "description": "Inline AI safety analysis for ChatGPT responses",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://chat.openai.com/*", "http://localhost:*/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "aegis"
  }
}
